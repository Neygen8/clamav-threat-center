<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.clamav.scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SCRIPT_DIR__/scan-clamav.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>19</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/scan-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/scan-launchd-error.log</string>
</dict>
</plist>

