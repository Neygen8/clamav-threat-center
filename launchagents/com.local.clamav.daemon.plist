<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.clamav.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CLAMD_PATH__</string>
    <string>--foreground</string>
    <string>--config-file=__CONFIG_FILE__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/clamd-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/clamd-launchd-error.log</string>
</dict>
</plist>
